# Cloudflare Pages headers

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Short cache + revalidate. Filenames here don't change between deploys (no
# content hashing), so a long max-age would keep serving a stale file for up
# to a year after every future edit — that's what caused the mobile-nav CSS
# fix to not show up immediately. 1 hour keeps things fast without that risk.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/videos/*
  Cache-Control: public, max-age=3600, must-revalidate
